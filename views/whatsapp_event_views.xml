<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gs_whatsapp_event_list" model="ir.ui.view">
        <field name="name">gs.whatsapp.event.list</field>
        <field name="model">gs.whatsapp.event</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="create_date"/>
                <field name="event_type"/>
                <field name="partner_id"/>
                <field name="phone"/>
                <field name="state"
                       widget="badge"
                       decoration-success="state == 'sent'"
                       decoration-danger="state == 'failed'"/>
                <field name="response_code"/>
            </list>
        </field>
    </record>

    <record id="view_gs_whatsapp_event_form" model="ir.ui.view">
        <field name="name">gs.whatsapp.event.form</field>
        <field name="model">gs.whatsapp.event</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="event_type"/>
                            <field name="partner_id"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="state" widget="badge"/>
                            <field name="response_code"/>
                            <field name="create_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload">
                            <field name="payload_html" nolabel="1" colspan="2"/>
                            <separator string="JSON"/>
                            <field name="payload_pretty" widget="ace" options="{'mode': 'json'}" nolabel="1" colspan="2"/>
                        </page>
                        <page string="Response">
                            <field name="response_pretty" widget="ace" options="{'mode': 'text'}" nolabel="1" colspan="2"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gs_whatsapp_event" model="ir.actions.act_window">
        <field name="name">WhatsApp Event Logs</field>
        <field name="res_model">gs.whatsapp.event</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
        <field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
